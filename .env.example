# ===== Sprint 2 - Environment Template (.env.example) =====
# Copia este archivo a .env (NO lo subas) solo para uso local
# En servidores usa variables de entorno del sistema o secretos del orquestador.

# ---- Profile & Server ----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOG_LEVEL=INFO

# ---- Basic Auth (solo dev/test) ----
BASIC_USER=admin
BASIC_PASS=admin123

# ---- Pagination (OrderAppProperties) ----
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ---- Database (ajusta según tu motor) ----
# Dev
DB_URL=jdbc:postgresql://localhost:5432/orders_dev
DB_USERNAME=dev_user
DB_PASSWORD=dev_pass

# Test (si corres servicios de test con otra BD)
#DB_URL=jdbc:postgresql://localhost:5432/orders_test
#DB_USERNAME=test_user
#DB_PASSWORD=test_pass

# Prod (NO pongas valores reales aquí; define en el servidor)
#DB_URL=
#DB_USERNAME=
#DB_PASSWORD=
